# Node modules folder
node_modules/

# Environment variables file (contains secret keys, DB credentials)
.env

# Log files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# System files (auto-generated by OS)
.DS_Store
Thumbs.db

# Temporary and cache files
tmp/
temp/
.cache/

# Build or dist folders (generated during deployment)
dist/
build/

# Uploaded files (user-generated content)
uploads/

# Editor or IDE config files
.vscode/
.idea/

# Optional: lock file (can be ignored if you want cleaner repo)
package-lock.json
